# [sc] Only the WebSocket endpoint and a health probe are reachable from the
# internet — the engine's web UI, preview, voices, models, and metrics routes
# simply don't exist publicly. handle blocks are mutually exclusive (a bare
# `respond 404` would otherwise outrank reverse_proxy in directive order).
dev-mc.spacechannel.com {
	handle /healthz {
		respond 200
	}

	handle /ws {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		respond 404
	}
}
